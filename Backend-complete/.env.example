# ==============================================================================
# Environment variables template for Docker Compose and local development
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# JWT Secret Key (required by API; must be a secure random string of at least 32 characters)
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars-long

# Initial Admin phone number (optional: seeds an ADMIN account at startup)
ADMIN_PHONE=+919000000001

# Allowed CORS origins (comma-separated list for frontend clients)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# Auth Provider:
# - 'dev': accepts test tokens (e.g. dev-token:+919876543210) without Firebase setup
# - 'firebase': verifies real Firebase phone auth (requires secrets/firebase-service-account.json)
AUTH_PROVIDER=dev

# Spring Profiles: 'dev' (OTP in responses, dev auth allowed) or 'prod'
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
POSTGRES_DB=onncall
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
